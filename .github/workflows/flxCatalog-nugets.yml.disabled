name: flxCatalog-nugets

on:
  workflow_dispatch:
  push:
    branches: ['**']
    tags: ['v*']

jobs:
  nugets:
    runs-on: ubuntu-latest

    timeout-minutes: 20

    permissions:
      contents: read
      packages: write

    steps:
      - uses: actions/checkout@v4
        with:
          # GitVersion necesita el historial completo para calcular la version.
          fetch-depth: 0

      - uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '9.0.x'

      - name: version
        # Esquema de versionado propio, calculado con "git rev-list --count" (no con
        # GitVersion: su modo de herencia entre ramas no daba resultados fiables para este
        # esquema). Major.Minor sale de flxCatalog-version.json; "commits desde que cambio la
        # version" cuenta desde el ultimo commit que toco ese fichero en la rama
        # correspondiente, asi que subir major/minor a mano reinicia el contador solo.
        #   main/master -> Major.Minor.0.<1 + commits desde el ultimo cambio de version en main>
        #   develop     -> Major.Minor.<commits desde el ultimo cambio de version en develop>.1-beta
        #   cualquier otra -> Major.Minor.<commits que develop llevaba en el punto de fork>.1-alpha.<commits propios de la rama>
        # El "+1" en main es a proposito: nuestras versiones nunca acaban en .0 (siempre
        # .1 como minimo), igual que develop y las demas ramas fijan el ultimo campo a 1.
        run: |
          MAJOR=$(jq -r '.major' flxCatalog-version.json)
          MINOR=$(jq -r '.minor' flxCatalog-version.json)

          # Ultimo commit que toco flxCatalog-version.json, alcanzable desde el ref dado.
          version_anchor() {
            git log -1 --format=%H "$1" -- flxCatalog-version.json
          }

          MAIN_REF="origin/main"
          if git show-ref --verify --quiet refs/remotes/origin/develop; then
            DEVELOP_REF="origin/develop"
          else
            DEVELOP_REF="$MAIN_REF"
          fi

          if [ "$GITHUB_REF_NAME" = "main" ] || [ "$GITHUB_REF_NAME" = "master" ]; then
            M=$(( $(git rev-list --count "$(version_anchor HEAD)..HEAD") + 1 ))
            VERSION="$MAJOR.$MINOR.0.$M"
            PACKAGE_VERSION="$VERSION"
          elif [ "$GITHUB_REF_NAME" = "develop" ]; then
            N=$(git rev-list --count "$(version_anchor HEAD)..HEAD")
            VERSION="$MAJOR.$MINOR.$N.1"
            PACKAGE_VERSION="$MAJOR.$MINOR.$N.1-beta"
          else
            MERGE_BASE=$(git merge-base "$DEVELOP_REF" HEAD)
            N=$(git rev-list --count "$(version_anchor "$MERGE_BASE")..$MERGE_BASE")
            K=$(git rev-list --count "$MERGE_BASE..HEAD")
            VERSION="$MAJOR.$MINOR.$N.1"
            PACKAGE_VERSION="$MAJOR.$MINOR.$N.1-alpha.$K"
          fi

          {
            echo "VERSION=$VERSION"
            echo "ASSEMBLY_VERSION=$VERSION"
            echo "PACKAGE_VERSION=$PACKAGE_VERSION"
            echo "INFORMATIONAL_VERSION=$PACKAGE_VERSION+sha.$(git rev-parse --short HEAD)"
          } | tee -a "$GITHUB_ENV"

      - name: restore
        timeout-minutes: 10
        run: dotnet restore flxCatalog.sln

      - name: publish frontend y backend
        # Genera las DLLs que empaquetan los nuspecs de Frontend/Backend/Library.
        run: |
          dotnet publish flxCatalog.Frontend/flxCatalog.Frontend.csproj -c Release \
            -o publish/flxCatalog/flxCatalog.Frontend \
            /p:Version=$VERSION /p:FileVersion=$ASSEMBLY_VERSION /p:InformationalVersion=$INFORMATIONAL_VERSION
          dotnet publish flxCatalog.Backend/flxCatalog.Backend.csproj -c Release \
            -o publish/flxCatalog/flxCatalog.Backend \
            /p:Version=$VERSION /p:FileVersion=$ASSEMBLY_VERSION /p:InformationalVersion=$INFORMATIONAL_VERSION

      - name: compilar proyectos de base de datos (dacpac)
        # Genera los .dacpac en bin/Release que empaquetan los nuspecs de base de datos.
        run: |
          dotnet build flxCatalog.Conf.Database/flxCatalog.Conf.Database.sqlproj -c Release -p:NetCoreBuild=true /p:DacVersion=$ASSEMBLY_VERSION
          dotnet build flxCatalog.Data.Database/flxCatalog.Data.Database.sqlproj -c Release -p:NetCoreBuild=true /p:DacVersion=$ASSEMBLY_VERSION

      - name: nugets
        run: |
          rm -rf publish/nuget
          dotnet pack tools/pack.csproj -o publish/nuget -p:NuspecProperties="version=$PACKAGE_VERSION" \
            -p:NuspecFile=$PWD/flxCatalog.Frontend/flxCatalog.Frontend.nuspec \
            -p:NuspecBasePath=$PWD/flxCatalog.Frontend
          dotnet pack tools/pack.csproj -o publish/nuget -p:NuspecProperties="version=$PACKAGE_VERSION" \
            -p:NuspecFile=$PWD/flxCatalog.Backend/flxCatalog.Library.nuspec \
            -p:NuspecBasePath=$PWD/flxCatalog.Backend
          dotnet pack tools/pack.csproj -o publish/nuget -p:NuspecProperties="version=$PACKAGE_VERSION" \
            -p:NuspecFile=$PWD/flxCatalog.Backend/flxCatalog.Backend.nuspec \
            -p:NuspecBasePath=$PWD/flxCatalog.Backend
          dotnet pack tools/pack.csproj -o publish/nuget -p:NuspecProperties="version=$PACKAGE_VERSION" \
            -p:NuspecFile=$PWD/flxCatalog.Conf.Database/flxCatalog.Conf.Database.nuspec \
            -p:NuspecBasePath=$PWD/flxCatalog.Conf.Database
          dotnet pack tools/pack.csproj -o publish/nuget -p:NuspecProperties="version=$PACKAGE_VERSION" \
            -p:NuspecFile=$PWD/flxCatalog.Data.Database/flxCatalog.Data.Database.nuspec \
            -p:NuspecBasePath=$PWD/flxCatalog.Data.Database

      - name: artefactos
        uses: actions/upload-artifact@v4
        with:
          # PACKAGE_VERSION (con sufijo -alpha./-beta. segun la rama) es el mismo que
          # llevan los .nupkg, asi el nombre del artifact identifica la version sin
          # tener que abrir el zip.
          name: flxCatalog-${{ env.PACKAGE_VERSION }}
          path: publish/nuget/*.nupkg
          if-no-files-found: error
      
      - name: crear release en GitHub (main, master y develop)
        # El resto de ramas (feature, etc.) se quedan solo con el artifact de la ejecucion.
        if: github.ref_name == 'main' || github.ref_name == 'master' || github.ref_name == 'develop'
        uses: softprops/action-gh-release@v2
        with:
          tag_name: v${{ env.VERSION }}
          name: v${{ env.VERSION }}
          target_commitish: ${{ github.sha }}
          generate_release_notes: true
          files: publish/nuget/*.nupkg
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: publicar en GitHub Packages (solo main)
        # develop y el resto de ramas se quedan fuera de Packages.
        if: github.ref_name == 'main' || github.ref_name == 'master'
        run: |
          dotnet nuget push "publish/nuget/*.nupkg" \
            --source "https://nuget.pkg.github.com/${{ github.repository_owner }}/index.json" \
            --api-key ${{ secrets.GITHUB_TOKEN }} \
            --skip-duplicate

