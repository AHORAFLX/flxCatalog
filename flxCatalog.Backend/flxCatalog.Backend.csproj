<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>flxCatalog.Backend</RootNamespace>
		<OutputPath>bin\</OutputPath>
		<PackageOutputPath>bin\</PackageOutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<EnableDefaultContentItems>false</EnableDefaultContentItems>
		<Version>1.0.0.0</Version>
		<!-- PostSharp viene transitivo de Flexygo.Backend pero este proyecto no usa aspectos -->
		<SkipPostSharp>true</SkipPostSharp>
	</PropertyGroup>

  <ItemGroup>
    <Folder Include="conf\" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="conf\**" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="conf\**\*.*" Exclude="conf\**\*.local.*">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- El contexto del docker build es la carpeta de publish, asi que el Dockerfile y el
         entrypoint tienen que viajar dentro de ella. Con EnableDefaultContentItems=false
         hay que declararlos a mano. -->
    <Content Include="Dockerfile" CopyToPublishDirectory="PreserveNewest" />
    <Content Include=".dockerignore" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="entrypoint_backend.sh" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\flxCatalog.Processes\flxCatalog.Processes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Flexygo.Backend" Version="10.0.0-beta.202">
      <ExcludeAssets>contentFiles</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>

