<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
	<metadata>
		<id>flxCatalog.Backend</id>
		<version>1.0.0.0</version>
		<title>flxCatalog Backend</title>
		<authors>Ahora Freeware</authors>
		<owners>Ahora Freeware</owners>
		<requireLicenseAcceptance>false</requireLicenseAcceptance>
		<description>Create your own Professional Solutions. Flexygo allows you to immediatly build incredible Solutions for companies, professionals and individuals. For easy installation visit https://nuget.flexygo.com/</description>
		<copyright>Copyright Â© 2017 Ahora Freeware</copyright>
		<projectUrl>http://flexygo.com</projectUrl>
		<iconUrl>https://docs.flexygo.com/isotipo.png</iconUrl>
		<tags>Rad Framework Rapid CMS Builder</tags>
		<releaseNotes />
		<!-- SOLO dependencias a:
		     - flxCatalog.Library (DLLs propias del nivel)
		     - Flexygo.Backend [pinned] (cadena del padre + .props heredados)
		     Las terceras llegan transitivamente. NO redeclarar SqlClient/Playwright/etc. -->
		<dependencies>
			<dependency id="flxCatalog.Library" version="$version$" />
			<dependency id="Flexygo.Backend" version="[10.0.0-beta.202]" />
		</dependencies>
		<contentFiles>
			<files include="**\*.*" buildAction="None" copyToOutput="true" flatten="false" />
		</contentFiles>
	</metadata>
	<files>
		<!-- contentFiles: ficheros estÃ¡ticos para dev consumer -->
		<file src="..\publish\flxCatalog\flxCatalog.Backend\web.config" target="contentFiles\any\any\" />
		<file src="..\publish\flxCatalog\flxCatalog.Backend\conf\appsettings.json" target="contentFiles\any\any\conf\" />
		<file src="..\publish\flxCatalog\flxCatalog.Backend\flxCatalog.Backend.*" target="contentFiles\any\any\" exclude="**\*.dll;**\*.pdb" />
		<file src="..\publish\flxCatalog\flxCatalog.Backend\MailLicense.xml" target="contentFiles\any\any\" />
		<file src="..\publish\flxCatalog\flxCatalog.Backend\**\Flexygo.UnitTest.*.json" target="contentFiles\any\any\" />
		<file src="..\publish\flxCatalog\flxCatalog.Backend\models\**\*" target="contentFiles\any\any\models\" />
		<!-- DLL propia del Backend de este nivel -->
		<file src="..\publish\flxCatalog\flxCatalog.Backend\**\*flxCatalog.Backend*.dll" target="lib\net9.0" />
		<!-- MSBuild auto-import (cadena de .props propios + heredados) -->
		<file src=".\buildTransitive\flxCatalog.Backend.props" target="buildTransitive" />
		<!-- tools/install/: output COMPLETO de dotnet publish (consumido por el instalador) -->
		<file src="..\publish\flxCatalog\flxCatalog.Backend\**\*" target="tools\install" exclude="**/appsettings.Development.json" />
		<file src="nuget\init.ps1" target="tools" />
		<!-- ICONO y Readme -->
		<file src="nuget\isotipo.png" target="images\" />
		<file src="nuget\readme.md" target="docs\" />
	</files>
</package>