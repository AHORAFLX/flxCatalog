# Copia este fichero a .env y ajusta los valores. .env esta en .gitignore.
#
# Contrasena del usuario sa de SQL Server dentro del contenedor de base de datos.
# CAMBIALA: el valor por defecto del compose es -CHANGE_me1234.
# Debe cumplir la politica de SQL Server: 8+ caracteres, con mayusculas,
# minusculas y digitos o simbolos.
SQL_PASSWORD=-CHANGE_me1234

# Puerto del host por el que se publica el frontend. Se asigna solo al crear
# el producto (evita el 7110/7111 que usa Visual Studio en local), asi que
# puedes tener varios productos levantados a la vez sin tocar nada. Cambia
# el valor si necesitas uno concreto. El backend no publica puerto: solo se
# llega a el por la red interna del compose.
FRONTEND_PORT=7628

# Tag de las tres imagenes. Debe coincidir con el -Tag que se paso a
# tools/build-docker-images.ps1.
IMAGE_TAG=latest

# Clave de Google Stitch, la que usa /flx-design para pedir el diseno de pantallas
# antes de construir. Sin ella el flujo sigue funcionando: se le piden al usuario
# sus propias pantallas y se comparan igual.
#
# OJO, esta no se lee de este fichero. Las demas variables las consume
# docker-compose; esta la expande el cliente MCP desde .mcp.json, asi que tiene
# que estar en el ENTORNO donde arranca Claude Code o VS Code, no solo en .env.
#
# La clave empieza por 'AQ.' y sale de la documentacion de Stitch, con sesion
# iniciada. Una clave de proyecto de Google Cloud (las que empiezan por 'AIza')
# NO sirve: el servidor la rechaza con 'API keys are not supported by this API'.
STITCH_API_KEY=
